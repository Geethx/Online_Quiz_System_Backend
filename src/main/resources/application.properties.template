# Online Quiz - Production Properties Template
# Copy this file to application.properties and update with actual credentials

spring.application.name=online-quiz

# Database Configuration
# For Supabase Pooler, use port 6543 and prepareThreshold=0
spring.datasource.url=${DB_URL:jdbc:postgresql://your-db-host:6543/postgres?prepareThreshold=0}
spring.datasource.username=${DB_USERNAME:your_username}
spring.datasource.password=${DB_PASSWORD:your_password}
spring.datasource.driver-class-name=org.postgresql.Driver

# HikariCP Connection Pool Tuning (Recommended for 200-300 concurrent users)
spring.datasource.hikari.maximum-pool-size=20
spring.datasource.hikari.minimum-idle=5
spring.datasource.hikari.idle-timeout=300000
spring.datasource.hikari.connection-timeout=20000
spring.datasource.hikari.max-lifetime=1200000

# JPA Configuration
# Use 'validate' in production; 'update' is for development only
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.properties.hibernate.format_sql=false

# Server Configuration
server.port=${PORT:8080}

# JWT Configuration
jwt.secret=${JWT_SECRET:your_secure_random_secret_at_least_32_chars}
jwt.expiration=${JWT_EXPIRATION:86400000}

# Logging Configuration
logging.level.org.springframework=INFO
logging.level.com.onlinequiz=INFO
logging.pattern.console=%d{yyyy-MM-dd HH:mm:ss} - %msg%n
